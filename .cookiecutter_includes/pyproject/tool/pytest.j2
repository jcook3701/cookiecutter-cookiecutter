{% macro config(
  config
) %}
# ====================================
# Pytest Configuration:
# ====================================
[tool.pytest.ini_options]
minversion = "7.0"
addopts = ["-v", "--maxfail=1", "-W always", "-rw", "--strict-markers"]
{% if config.ansible %}
testpaths = ["tests"]
pythonpath = ["plugins"]
{% else %}
testpaths = ["tests"]
pythonpath = ["hooks"]
{% endif %}
{% endmacro %}
