{% macro phony(
    jekyll_enabled,
    sphinx_enabled
) -%}
    {%- set targets = [
        'all', 'list-folders', 'format-check', 'format-fix',
        'lint-check', 'lint-fix', 'spellcheck', 'typecheck', 'test',
    ] -%}
    {%- set python_targets = [
        'venv', 'install', 'pre-commit-init', 'security',
        'dependency-check', 'black-formatter-check', 'black-formatter-fix',
        'ruff-lint-check', 'ruff-lint-fix', 'toml-lint-check',
        'yaml-lint-check', 'jinja2-lint-check',
    ] -%}

    {%- if sphinx_enabled %}{% do targets.append('sphinx') %}{% endif %}
	{%- if jekyll_enabled %}{% do targets.extend(['jekyll', 'jekyll-serve', 'run-docs']) %}{% endif %}
    {%- do targets.extend(['build-docs', 'bump-version-patch', 'changelog', 'clean', 'help']) -%}

.PHONY: {{ targets | join(' \\\n\t') }}
{%- endmacro -%}
