{%- from '.cookiecutter_includes/registry/_config.j2' import ns with context -%}
{%- import '.cookiecutter_includes/makefile/utils.j2' as utils with context -%}

{% macro render_config() -%}
    {{ utils.section_header("Configuration Settings", "⚙️") }}

    {% for section_id, section_data in ns.settings.items() %}
    {{- '# ---' }} ~ {{ section_data._icon | default('🔹') }} {{ section_data._title | default(section_id | capitalize) }}
        {% for key, meta in section_data.items() if not key.startswith('_') %}
            {%- set value = meta.val -%}
            {# Apply quotes if the meta-dict says so #}
            {%- if meta.quote | default(false) -%}{%- set value = '"' ~ value ~ '"' -%}{%- endif -%}
                {{- "%-30s" | format(key.upper()) }} ?= {{ value }} # {{ meta.label | default(key) }}
        {% endfor %}
    {% endfor %}
{%- endmacro %}


{% macro debug_all() -%}
{{ utils.section_header("NAMESPACE DEBUG DUMP", "🪲") }}

# === 1. SETTINGS (Variables) ===
{% for section_id, data in ns.settings.items() -%}
# [{{ "%-10s" | format(section_id | upper) }}]: {{ data.keys() | list | join(', ') }}
{% endfor %}

# === 2. FEATURES (Booleans) ===
{% for lang, features in ns.features.items() -%}
{% if features %}
# [{{ "%-10s" | format(lang | upper) }}]
{% for key, val in features.items() %}
#   - {{ "%-15s" | format(key) }} = {{ val }}
{% endfor %}
{% endif %}
{%- endfor %}

# === 3. ACTIVE TOOLS (The Registry) ===
# Count: {{ ns.active_tools | length }}
{% for tool in ns.active_tools %}
# -> ID: {{ "%-15s" | format(tool.config.id) }} | Group: {{ tool.config.group }}
{% else %}
# !!! WARNING: No tools found in ns.active_tools !!!
{%- endfor %}

# === 4. ACTIVE SECTIONS ===
{% for group_id, tools in ns.active_sections.build.items() -%}
# [{{ "%-10s" | format(group_id | upper) }}]: {{ tools.keys() | join(', ') }}
{% endfor %}
{% endmacro %}
