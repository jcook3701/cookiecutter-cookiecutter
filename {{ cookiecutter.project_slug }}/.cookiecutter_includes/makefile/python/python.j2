{% import '.cookiecutter_includes/makefile/python/bump-my-version.j2' as bump_my_version with context %}
{% import '.cookiecutter_includes/makefile/python/codespell.j2' as codespell with context %}
{% import '.cookiecutter_includes/makefile/python/cookiecutter.j2' as cookie with context %}
{% import '.cookiecutter_includes/makefile/python/deptry.j2' as deptry with context %}
{% import '.cookiecutter_includes/makefile/python/djlint.j2' as djlint with context %}
{% import '.cookiecutter_includes/makefile/python/git.j2' as git with context %}
{% import '.cookiecutter_includes/makefile/python/git-cliff.j2' as git_cliff with context %}
{% import '.cookiecutter_includes/makefile/python/jinja-cli.j2' as jinja_cli with context %}
