{% macro actions(

) %}
    {#
        Generates Makefile actions using dependency management commands.

        Args:
            TODO: (str): .

        Returns:
            str: Makefile dependency management actions section.
    #}
# --------------------------------------------------
# 🧬 Dependency Checks
# --------------------------------------------------
git-dependency-check:
	$(AT)which $(GIT) >/dev/null || \
		{ echo "Git is required: sudo apt install git"; exit 1; }

gh-dependency-check:
	$(AT)which $(GITHUB) >/dev/null || \
		{ echo "GitHub is required: sudo apt install gh"; exit 1; }

    {{- python.deptry.shell_cmd }}
{% endmacro %}
