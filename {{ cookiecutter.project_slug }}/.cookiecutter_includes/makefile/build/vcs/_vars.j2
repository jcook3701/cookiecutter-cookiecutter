{% set vcs_dev_stack = [
    {
        "id": "git-init",
        "name": "Git Init",
        "icon": "🌱",
        "group": "vcs",
        "command": "git init",
        "args": "-b {{ cookiecutter._default_branch }}",
        "description": "Initialize the local repository."
    },
    {
        "id": "git-remote",
        "name": "Git Remote",
        "icon": "🌐",
        "group": "vcs",
        "command": "git remote add origin",
        "args": "{{ cookiecutter.repo_url }}.git",
        "description": "Link to the GitHub remote."
    },
    {
        "id": "git-status",
        "name": "Git Status",
        "icon": "📊",
        "group": "vcs",
        "command": "git status",
        "args": "",
        "description": "Show status of working tree."
    },
    {
        "id": "git-stage",
        "name": "Git Add",
        "icon": "➕",
        "group": "vcs",
        "command": "git add",
        "args": "-A",
        "description": "Stage all current changes."
    },
    {
        "id": "git-commit",
        "name": "Git Commit",
        "icon": "💾",
        "group": "vcs",
        "command": "git commit",
        "args": "-m 'feat: initial commit'",
        "description": "Create an initial commit."
    },
    {
        "id": "git-clean",
        "name": "Git Clean",
        "icon": "🧹",
        "group": "vcs",
        "command": "git clean",
        "args": "-fdx",
        "description": "Remove all untracked/ignored files."
    }
] %}
