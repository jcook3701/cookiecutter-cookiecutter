{% from '.cookiecutter_includes/makefile/_vars.j2' import ns with context %}

{%- import '.cookiecutter_includes/makefile/build/vcs/git.j2' as _git with context -%}
{%- import '.cookiecutter_includes/makefile/build/vcs/gh.j2' as _gh with context -%}

{%- set git = _git -%}
{%- set github = _gh -%}

{%- set _all_tools = [
    git,
    github
] -%}

{# #TODO: Deprecated:  Solved with _config files. #}
{%- set active_tools = [] -%}
{%- for tool in _all_tools -%}
    {% if tool.config is defined %}
        {%- set tool_id = tool.config.id -%}
        {%- set feature_id = tool_id | upper -%}

        {%- set is_core = tool_id == 'git' -%}

        {%- if is_core or ns.features.vcs.get(feature_id) | default(false) -%}
            {%- do active_tools.append(tool) -%}
            {%- do ns.active_tools.append(tool) -%}
        {%- endif -%}
    {% endif %}
{%- endfor -%}
