{% import '.cookiecutter_includes/registry/engines/rust/__init__.j2' as rust with context %}
{% import '.cookiecutter_includes/registry/engines/python/__init__.j2' as python with context %}


{% macro header(
    title,
    packages,
    emoji=""
) %}
    {#
        Generates file section header.

        Args:
            title (str): header title.
			packages (list[str]): list of packages.
			sphinx_enabled (optional(str)): related title emoji.

        Returns:
            str: File section header.
    #}
# --------------------------------------------------
# {{ emoji }} {{ title }}
# --------------------------------------------------
{% endmacro %}


{#
# --------------------------------------------------
# 📜 Changelog generation (git-cliff)
# --------------------------------------------------
#}
{% macro cmds(

) %}
    {#
        Generates Makefile changelog commands section.

        Args:
            TODO: (str): .

        Returns:
            str: Makefile changelog commands section.
    #}
    {{- rust.git_cliff.python_cmd }}
{% endmacro %}


{#
# --------------------------------------------------
# 📜 Changelog generation (git-cliff)
# --------------------------------------------------
#}
{% macro actions(

) %}
    {#
        Generates Makefile actions using changelog commands.

        Args:
            TODO: (str): .

        Returns:
            str: Makefile changelog actions section.
    #}
    {{- rust.git_cliff.shell_cmd }}
{% endmacro %}
