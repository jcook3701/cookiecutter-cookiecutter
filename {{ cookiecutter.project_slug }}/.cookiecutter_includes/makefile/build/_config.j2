{%- set features = {
    "lang": {
        "ANSIBLE":    cookiecutter.add_ansible | default(false),
        "DOCKER":     cookiecutter.add_docker | default(false),
        "GCC":        cookiecutter.add_gcc | default(false),
        "ROS2":       cookiecutter.add_ros2 | default(false),
        "RUST":       cookiecutter.add_rust | default(false),
    },
    "tools": {
        "GITHUB":     cookiecutter.add_github_actions | default(false),
    },
    "core": {
        "BUILT_IN":   true,
        "CHANGELOGS": true,
        "DEPS":       true,
        "FORMAT":     true,
        "LINT":       true,
        "PRE_COMMIT": cookiecutter.add_pre_commit | default(false),
        "RELEASE":    true,
        "SECURITY":   true,
        "SPELLING":   true,
        "TEMPLATE":   true,
        "TESTING":    true,
        "TYPING":     true,
        "UPGRADER":   cookiecutter.add_upgrader | default(false),
        "VERSIONING": true
    },
    "pipeline": {

    },
} -%}
