{% set config = {
    "id": "venv",
    "name": "Virtual Environment",
    "icon": "🐍",
    "group": "setup",
    "command": "$(PYTHON_CMD) -m venv",
    "start_msg": "Creating virtual environment...",
    "end_msg": "Virtual environment created.",
    "modes": {
        "create": "$(VENV_DIR)"
    }
} %}

{# We define the ACTIVATE and PYTHON strings here as they are helpers, not just tools #}
{% macro helpers() %}
CREATE_VENV := $(PYTHON_CMD) -m venv $(VENV_DIR)
ACTIVATE := source $(VENV_DIR)/bin/activate
PYTHON := $(ACTIVATE) && $(PYTHON_CMD)
{% endmacro %}


{# #TODO: Deprecated beyond this point!!!! #}
{#
# --------------------------------------------------
# 🐍 Python / Virtual Environment
# --------------------------------------------------
#}
{% set settings %}
VENV_DIR := $(PROJECT_ROOT)/.venv
{% endset %}


{% set python_cmd %}
CREATE_VENV := $(PYTHON_CMD) -m venv $(VENV_DIR)
ACTIVATE := source $(VENV_DIR)/bin/activate
PYTHON := $(ACTIVATE) && $(PYTHON_CMD)
{% endset %}



{#
# --------------------------------------------------
# 🐍 Virtual Environment Setup
# --------------------------------------------------
#}
{% set shell_cmd %}
venv:
	$(AT)echo "🐍 Creating virtual environment..."
	$(AT)$(CREATE_VENV)
	$(AT)echo "✅ Virtual environment created."
{% endset %}
