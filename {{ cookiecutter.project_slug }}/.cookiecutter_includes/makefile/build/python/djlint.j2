{% set config = {
    "id": "djlint",
    "name": "djLint",
    "icon": "✨",
    "group": "lint",
    "command": "$(ACTIVATE) && djlint",
    "start_msg": "djlint lint...",
    "end_msg": "Finished linting check of jinja2 macro files with djlint!",
    "modes": {
        "lint-check": ". --lint --profile=jinja",
        "lint-fix": ". --reformat"
    }
} %}

{# #TODO: Deprecated beyond this point!!!! #}
{% set python_cmd %}
DJLINT := $(ACTIVATE) && djlint
{% endset %}


{% set shell_cmd %}
djlint-lint-check:
	$(AT)echo "🔍 djlint lint..."
	$(AT)$(DJLINT) . --lint --profile=jinja
	$(AT)echo "✅ Finished linting check of jinja2 macro files with djlint!"

djlint-lint-fix:
	$(AT)echo "🔍 djlint reformat..."
	$(AT)$(DJLINT) . --reformat
	$(AT)echo "✅ Finished reformatting of jinja2 macro files with djlint!"
{% endset %}
