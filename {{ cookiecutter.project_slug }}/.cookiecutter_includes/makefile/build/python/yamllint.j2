{% set config = {
    "id": "yamllint",
    "name": "Yamllint",
    "icon": "📄",
    "group": "lint",
    "command": "$(PYTHON) -m yamllint",
    "start_msg": "Running yamllint...",
    "end_msg": "Finished linting check of yaml files with yamllint!",
    "modes": {
        "check": "$(PROJECT_ROOT) $(RENDERED_COOKIE_DIR)"
    }
} %}


{# #TODO: Deprecated beyond this point!!!! #}
{% set python_cmd %}
YAMLLINT := $(PYTHON) -m yamllint
{% endset %}


{% set shell_cmd %}
yaml-lint-check:
	$(AT)echo "🔍 Running yamllint..."
	$(AT)$(YAMLLINT) $(PROJECT_ROOT)
	$(AT)$(YAMLLINT) $(RENDERED_COOKIE_DIR)
	$(AT)echo "✅ Finished linting check of yaml files with yamllint!"
{% endset %}
