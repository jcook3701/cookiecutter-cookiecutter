{%- import '.cookiecutter_includes/makefile/utils.j2' as utils with context -%}

{%- set python_settings_map = {
    "python_settings": {
        "_title": "Python Settings",
        "_icon": "🐍",
        "DEPS":     {"val": "."},
        "DEV_DEPS": {"val": ".[dev]"},
        "DEV_DOCS": {"val": ".[docs]"}
    },
    "python_infra": {
        "_title": "Python Commands (venv, activate, pip)",
        "_icon": "🐍",
        "PYTHON_CMD": {"val": "python" ~ cookiecutter.python_version}
    }
} -%}

{%- set python_cmd_map = {
    "BLACK":        cookiecutter.__python.black,
    "BUILD":        cookiecutter.__python.build | default(false),
    "BUMPVERSION":  cookiecutter.__python.bump_my_version,
    "CODESPELL":    cookiecutter.__python.codespell,
    "DEPTRY":       cookiecutter.__python.deptry,
    "DJLINT":       cookiecutter.__python.djlint,
    "JINJA":        cookiecutter.__python.jinja_cli | default(false),
    "MYPY":         cookiecutter.__python.mypy,
    "PIPAUDIT":     cookiecutter.__python.pip_audit,
    "PRECOMMIT":    cookiecutter.__python.pre_commit,
    "PYTEST":       cookiecutter.__python.pytest,
    "RUFF":         cookiecutter.__python.ruff,
    "TOMLLINT":     cookiecutter.__python.tomllint,
    "TWINE":        cookiecutter.__python.twine | default(false),
    "YAMLLINT":     cookiecutter.__python.yamllint
} -%}

{%- set validate = utils.validate_features(python_cmd_map, "python/_config.j2") -%}
{% if validate == "PASS" %}
    {% set features = python_cmd_map %}
{% endif %}
