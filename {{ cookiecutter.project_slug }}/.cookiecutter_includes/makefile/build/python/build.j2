{# .cookiecutter_includes/makefile/build/python/build.j2 #}

{% set config = {
    "id": "build",
    "name": "Build System",
    "icon": "📦",
    "group": "pkg",
    "command": "$(PYTHON) -m build",
    "start_msg": "Packing $(PROJECT_NAME)...",
    "end_msg": "$(PROJECT_NAME) packaging complete!",
    "modes": {
        "package": ""
    }
} %}

{# We add a custom action here because you want a specific echo message #}
{% macro actions(cfg=config) %}
# --- {{ cfg.name }} ---
{{ cfg.id }}: ## {{ cfg.icon }} Package the project
	$(AT)echo "{{ cfg.icon }} Packing $(PROJECT_NAME)..."
	$(AT)$(BUILD)
	$(AT)echo "✅ $(PROJECT_NAME) packaging complete!"
{% endmacro %}
