{% set settings %}
# --------------------------------------------------
# 🐍 Python Settings
# --------------------------------------------------
DEPS := .
DEV_DEPS := .[dev]
DEV_DOCS := .[docs]
{% endset %}


{% set python_cmd %}
# --------------------------------------------------
# 🐍 Python Commands (venv, activate, pip)
# --------------------------------------------------
PYTHON_CMD := python3.11
{% endset %}


{% set shell_cmd %}

{% endset %}


{% set python_build_cmd %}
# --------------------------------------------------
# 📦 Build (build)
# --------------------------------------------------
BUILD := $(PYTHON) -m build
{% endset %}


{% set shell_build_cmd %}
# --------------------------------------------------
# 📦 Build program (build)
# --------------------------------------------------
build:
	$(AT)echo "📦 Packing $(PACKAGE_NAME)..."
	$(AT)$(BUILD)
	$(AT)echo "✅ $(PACKAGE_NAME) packaging complete!"
{% endset %}
