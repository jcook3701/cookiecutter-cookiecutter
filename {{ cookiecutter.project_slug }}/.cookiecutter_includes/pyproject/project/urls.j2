{% macro create(
    github_io_url,
    repo_url
) %}
    {#
        Generates project.url, section of pyproject configuration file.

        Args:
            github_io_url (str): Project name.
            repo_url (str): Project version.

        Returns:
            str: project.url, section of pyproject configuration file.
    #}
[project.urls]
Homepage = "{{ github_io_url }}"
Repository = "{{ repo_url }}"
Documentation = "{{ github_io_url }}"
{% endmacro %}
