{% macro validate_features(mapping, file_path="UNKNOWN_FILE") -%}
    {%- set result = {} -%}
    {%- for key, value in mapping.items() -%}
        {%- if value is not undefined -%}
            {%- do result.update({key: value}) -%}
        {%- else -%}
            {# Forces the error to show both the key and the file path #}
            {%- set error_bucket = {} -%}
            {{ error_bucket[' >>> MISSING_VARIABLE: [' ~ key | lower ~ '] >>> FOUND_IN: [' ~ file_path ~ '] <<< '] }}
        {%- endif -%}
    {%- endfor -%}
    {{- "PASS" -}}
{%- endmacro %}
