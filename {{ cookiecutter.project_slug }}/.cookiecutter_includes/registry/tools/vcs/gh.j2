{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for the GitHub CLI (gh).
        Maps repository management and release automation to the global groups.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object including the group metadata.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "github",
        "name": "GitHub CLI",
        "icon": "🐙",
        "group": groups.vcs,
        "command": "gh",
        "description": "GitHub’s official command line tool for repository and release management.",
        "modes": {
            "check": {
                "args": "--version",
                "group": groups.info,
                "start_msg": "🔍 Checking GitHub CLI version...",
                "end_msg": "✅ GitHub CLI version check complete!"
            },
            "auth": {
                "args": "auth status",
                "group": groups.setup,
                "start_msg": "🔐 Checking GitHub authentication status...",
                "end_msg": "✅ Authentication check complete!"
            },
            "release": {
                "args": "release create $(" ~ s.project.release.label ~ ") --generate-notes",
                "group": groups.release,
                "start_msg": "🚀 Creating GitHub release for $(" ~ s.project.release.label ~ ")...",
                "end_msg": "✅ GitHub release created!"
            },
            "repo-view": {
                "args": "repo view --web",
                "group": groups.info,
                "start_msg": "🌐 Opening GitHub repository in browser...",
                "end_msg": "✅ Repository opened!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}
