{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for Ansible Lint.
        Maps to the global linting group for project-wide consistency.

        Args:
            groups (dict): The hydrated pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object.
    #}
    {%- set config = {
        "id": "ansible-lint",
        "name": "Ansible Lint",
        "icon": "🛡️",
        "group": groups.lint,
        "command": "ansible-lint",
        "args": settings.dirs.root.label ~ "/ansible",
        "start_msg": "🔍 Running Ansible Lint for best practices check...",
        "end_msg": "✅ Ansible Linting complete!",
        "description": "Best practices linter for Ansible playbooks and roles."
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}
