{%- import '.cookiecutter_includes/registry/debug.j2' as debug with context -%}

{%- set ansible_settings = cookiecutter.__python.ansible | default(false) %}

{%- set ansible_map ={
    "GALAXY":    ansible_settings,
} -%}

{%- set validate = debug.validate_features(ansible_map, "ansible/_config.j2") -%}
{% if validate == "PASS" %}
    {% set features = ansible_map %}
{% endif %}
