{% set config = {
    "id": "ansible-galaxy",
    "name": "Ansible Galaxy",
    "icon": "🌌",
    "command": "ansible-galaxy",
    "modes": [
        {
            "id": "galaxy-init",
            "name": "Ansible Galaxy Initialization",
            "icon": "🌌",
            "group": "vcs",
            "command": "collection init",
            "args": "{{ cookiecutter.github_username }}.{{ cookiecutter.project_slug }}",
            "description": "Initialize a new Ansible collection structure."
        },
        {
            "id": "galaxy-install",
            "name": "Ansible Galaxy Install",
            "icon": "📦",
            "group": "deps",
            "command": "install",
            "args": "-r requirements.yml",
            "description": "Install dependent roles and collections."
        },
        {
            "id": "galaxy-build",
            "name": "Ansible Galaxy Build",
            "icon": "🏗️",
            "group": "build",
            "command": "collection build",
            "args": "--force",
            "description": "Build the collection artifact (tarball) for publishing."
        },
        {
            "id": "galaxy-publish",
            "name": "Ansible Galaxy Publish",
            "icon": "🚢",
            "group": "publish",
            "command": "collection publish",
            "args": "*.tar.gz --api-key $(GALAXY_API_KEY)",
            "description": "Upload the collection to Ansible Galaxy."
        }
    ],
    "description": " Ansible Galaxy Toolset."
} %}

