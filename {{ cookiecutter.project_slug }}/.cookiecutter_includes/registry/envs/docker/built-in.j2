{% set config = {
    "id": "docker-build",
    "name": "Docker Build",
    "icon": "🐳",
    "group": "build",
    "command": "docker",
    "modes": [
        {
            "id": "docker-build",
            "name": "Docker Build",
            "icon": "🏗️",
            "group": "build",
            "command": "build",
            "args": "-t $(GITHUB_REPO):$(VERSION) .",
            "description": "Build the container image using the Dockerfile."
        },
        {
            "id": "docker-run",
            "name": "Docker Run",
            "icon": "🚀",
            "group": "test",
            "command": "run",
            "args": "--rm -it $(GITHUB_REPO):$(VERSION)",
            "description": "Run the container locally for testing."
        },
        {
            "id": "hadolint",
            "name": "Hadolint",
            "icon": "",
            "group": "lint",
            "command": "run",
            "args": "--rm -i hadolint/hadolint < Dockerfile",
            "description": "Lint the Dockerfile to ensure best practices."
        },
        {
            "id": "docker-scan",
            "name": "Docker Scan",
            "icon": "🔍",
            "group": "security",
            "command": "scan",
            "args": "$(GITHUB_REPO):$(VERSION)",
            "description": "Scan the image for vulnerabilities."
        },
        {
            "id": "docker-push",
            "name": "Docker Push",
            "icon": "🚢",
            "group": "",
            "command": "push",
            "args": "$(GITHUB_REPO):$(VERSION)",
            "description": "Push the image to the configured registry."
        },
        {
            "id": "docker-prune",
            "name": "Docker Prune",
            "icon": "🧹",
            "group": "vcs",
            "command": "system prune",
            "args": "-f",
            "description": "Remove unused data to save disk space."
        }
    ],
} %}

