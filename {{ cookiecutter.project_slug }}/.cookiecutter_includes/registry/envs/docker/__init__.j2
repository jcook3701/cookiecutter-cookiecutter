{%- import '.cookiecutter_includes/registry/utils.j2' as utils with context -%}
{%- import '.cookiecutter_includes/registry/envs/docker/built-in.j2' as _docker  with context -%}

{%- macro get_active_tools(ns) -%}
    {#
        Registers active Docker tools into the global namespace.

        Args:
            ns (namespace): Global project namespace.
    #}
    {%- set docker = {} -%}

    {%- do _docker.get_config(ns.pkg_groups, ns.settings, docker) %}

    {%- set tools_to_check = [
        docker,
    ] -%}

    {%- for tool_cfg in tools_to_check -%}
        {%- if tool_cfg is mapping -%}
            {%- set feature_id = tool_cfg.id | upper | replace("-", "_") -%}
            {%- set is_enabled = ns.features.envs.docker.get(feature_id) | default(false) %}

            {%- if is_enabled -%}
                {{- utils.register_tool(ns, tool_cfg) -}}
            {%- endif -%}
        {% endif %}
    {%- endfor -%}
{% endmacro %}
