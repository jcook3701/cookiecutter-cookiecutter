{% set ros2_dev_stack = [
    {
        "id": "rosdep-install",
        "name": "Rosdep Install",
        "icon": "📦",
        "group": "deps",
        "command": "rosdep install",
        "args": "--from-paths src --ignore-src -r -y",
        "description": "Install all system dependencies defined in package.xml."
    },
    {
        "id": "colcon-build",
        "name": "Colcon Build",
        "icon": "🏗️",
        "group": "build",
        "command": "colcon build",
        "args": "--symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release",
        "description": "Build the workspace using symlink-install for fast development."
    },
    {
        "id": "colcon-test",
        "name": "Colcon Test",
        "icon": "🧪",
        "group": "test",
        "command": "colcon test",
        "args": "--event-handlers console_direct+ --return-code-on-test-failure",
        "description": "Run tests for all packages in the workspace."
    },
    {
        "id": "ament-lint",
        "name": "Ament Lint",
        "icon": "🛡️",
        "group": "lint",
        "command": "ament_lint_common",
        "args": "src/{{ cookiecutter.project_slug }}",
        "description": "Run standard ROS 2 linters (cppcheck, flake8, pep257, etc)."
    },
    {
        "id": "ros-source",
        "name": "Source Workspace",
        "icon": "🐚",
        "group": "utility",
        "command": "source",
        "args": "install/setup.bash",
        "description": "Source the current workspace environment."
    },
    {
        "id": "bloom-release",
        "name": "Bloom Release",
        "icon": "🌸",
        "group": "release",
        "command": "bloom-release",
        "args": "--rosdistro {{ cookiecutter.ros_distro | default('humble') }} --track {{ cookiecutter.ros_distro | default('humble') }} {{ cookiecutter.project_slug }}",
        "description": "Generate release metadata for the ROS buildfarm."
    }
] %}

{#
colcon-build: ## 🏗️ Build ROS 2 workspace
	$(AT)bash -c "source /opt/ros/$(ROS_DISTRO)/setup.bash && colcon build $(ARGS)"
#}
