{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for the Bloom Release tool.
        Maps ROS distro metadata generation to the global release group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object including the group metadata.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "bloom-release",
        "name": "Bloom Release",
        "icon": "🌸",
        "group": groups.release,
        "command": "bloom-release",
        "description": "Generate release metadata for the ROS buildfarm.",
        "modes": {
            "release": {
                "args": "--rosdistro " ~ cookiecutter.ros_distro | default('humble') ~ " " ~
                        "--track " ~ cookiecutter.ros_distro | default('humble') ~ " " ~
                        "$(" ~ s.project.name.label ~ ")",
                "start_msg": "🌸 Generating ROS release metadata with Bloom...",
                "end_msg": "✅ Bloom release metadata generated!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}
