{% set gcc_dev_stack = [
    {
        "id": "cmake-configure",
        "name": "CMake Config",
        "icon": "⚙️",
        "group": "build",
        "command": "cmake",
        "args": "-S . -B build -DCMAKE_BUILD_TYPE=Release",
        "description": "Configure the project and generate build files."
    },
    {
        "id": "cmake-build",
        "name": "CMake Build",
        "icon": "🏗️",
        "group": "build",
        "command": "cmake --build build",
        "args": "-j $(nproc)",
        "description": "Compile the project using all available cores."
    },
    {
        "id": "cppcheck",
        "name": "Cppcheck",
        "icon": "🛡️",
        "group": "lint",
        "command": "cppcheck",
        "args": "--enable=all --suppress=missingIncludeSystem .",
        "description": "Static analysis for C/C++ code."
    },
    {
        "id": "clang-format",
        "name": "Clang Format",
        "icon": "✨",
        "group": "format",
        "command": "clang-format",
        "args": "-i --style=file src/*.cpp include/*.hpp",
        "description": "Format code according to .clang-format file."
    },
    {
        "id": "ctest",
        "name": "CTest",
        "icon": "🧪",
        "group": "test",
        "command": "cd build && ctest",
        "args": "--output-on-failure",
        "description": "Run the test suite via CMake's test runner."
    },
    {
        "id": "gdb",
        "name": "GDB",
        "icon": "🐛",
        "group": "debug",
        "command": "gdb",
        "args": "./build/$(PROJECT_NAME)",
        "description": "Debug the compiled binary."
    },
    {
        "id": "cpack",
        "name": "CPack",
        "icon": "📦",
        "group": "release",
        "command": "cd build && cpack",
        "args": "-G DEB",
        "description": "Generate distribution packages (DEB, RPM, or TGZ)."
    }
] %}

{#
cmake-build: cmake-configure ## 🏗️ Build the binary
	$(AT){{ tool.command }} {{ tool.args }}
#}
