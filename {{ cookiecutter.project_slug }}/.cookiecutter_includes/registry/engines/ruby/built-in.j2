{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for Bundler (Ruby).
        Maps dependency management and environment setup to the global setup group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object for core Ruby dependency management.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "bundler",
        "name": "Bundler",
        "icon": "💎",
        "group": groups.setup,
        "command": "$(" ~ s.ruby_tools.bundler.label ~ ")",
        "description": "The Ruby dependency manager and environment controller.",
        "modes": {
            "install": {
                "args": "install --path $(" ~ s.ruby_settings.bundle_path.label ~ ")",
                "start_msg": "💎 Installing Ruby gems into $(" ~ s.ruby_settings.bundle_path.label ~ ")...",
                "end_msg": "✅ Gem installation complete!"
            },
            "update": {
                "args": "update",
                "start_msg": "🔄 Updating Ruby gems via Bundler...",
                "end_msg": "✅ Gems updated successfully!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}
