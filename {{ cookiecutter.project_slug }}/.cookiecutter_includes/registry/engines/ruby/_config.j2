{%- import '.cookiecutter_includes/registry/debug.j2' as debug with context -%}

{%- set ruby_settings_map = {
    "ruby_settings": {
        "_title": "Ruby Settings",
        "_icon": "💎",
        "ruby_version": {"val": "3.3.0", "label": "RUBY_VERSION"},
        "gemfile":      {"val": "$(PROJECT_ROOT)/Gemfile", "label": "GEMFILE"},
        "bundle_path":  {"val": "$(PROJECT_ROOT)/vendor/bundle", "label": "BUNDLE_PATH"}
    },
    "ruby_tools": {
        "_title": "Ruby Tools",
        "_icon": "🛠️",
        "bundler":      {"val": "bundle", "label": "BUNDLER"},
        "rake":         {"val": "rake",   "label": "RAKE"},
        "rubocop":      {"val": "rubocop", "label": "RUBOCOP"},
        "rspec":        {"val": "rspec",   "label": "RSPEC"}
    }
} -%}

{%- set ruby_cmd_map ={
    "BUNDLER":       cookiecutter.__ruby.bundler | default(false),
    "JEKYLL":        cookiecutter.__ruby.jekyll | default(true),
    "RAKE":          cookiecutter.__ruby.rake | default(false),
    "RUBOCOP":       cookiecutter.__ruby.rubocop | default(false),
    "RSPEC":         cookiecutter.__ruby.rspec | default(false),
} -%}

{%- set validate = debug.validate_features(ruby_cmd_map, "ruby/_config.j2") -%}
{% if validate == "PASS" %}
    {% set features = ruby_cmd_map %}
    {% set settings = ruby_settings_map %}
{% endif %}
