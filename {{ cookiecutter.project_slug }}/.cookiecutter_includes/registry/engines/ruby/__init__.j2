{%- import '.cookiecutter_includes/registry/utils.j2' as utils with context -%}
{%- import '.cookiecutter_includes/registry/engines/ruby/built-in.j2' as _built_in with context -%}
{%- import '.cookiecutter_includes/registry/engines/ruby/jekyll.j2' as _jekyll with context -%}
{%- import '.cookiecutter_includes/registry/engines/ruby/rake.j2' as _rake with context -%}
{%- import '.cookiecutter_includes/registry/engines/ruby/rspec.j2' as _rspec with context -%}
{%- import '.cookiecutter_includes/registry/engines/ruby/rubocop.j2' as _rubocop with context -%}

{% macro get_active_tools(ns) %}
    {#
        Registers active Ruby tools into the global namespace.

        Args:
            ns (namespace): Global project namespace.
    #}

    {%- set jekyll = {} -%}
    {%- set rake = {} -%}
    {%- set rspec = {} -%}
    {%- set rubocop = {} -%}

    {%- do _jekyll.get_config(ns.pkg_groups, ns.settings, jekyll) -%}
    {%- do _rake.get_config(ns.pkg_groups, ns.settings, rake) -%}
    {%- do _rspec.get_config(ns.pkg_groups, ns.settings, rspec) -%}
    {%- do _rubocop.get_config(ns.pkg_groups, ns.settings, rubocop) -%}

    {%- set tools_to_check = [
        jekyll,
        rake,
        rspec,
        rubocop
    ] -%}

    {%- for tool_cfg in tools_to_check -%}
        {%- if tool_cfg is mapping -%}
            {%- set feature_id = tool_cfg.id | upper | replace("-", "_") -%}

            {%- set is_core = feature_id in ['JEKYLL'] -%}
            {%- set is_enabled = ns.features.engines.ruby.get(feature_id) | default(false) -%}

            {%- if is_core or is_enabled -%}
                {{- utils.register_tool(ns, tool_cfg) -}}
            {%- endif -%}
        {%- endif -%}
    {%- endfor -%}
{% endmacro %}
