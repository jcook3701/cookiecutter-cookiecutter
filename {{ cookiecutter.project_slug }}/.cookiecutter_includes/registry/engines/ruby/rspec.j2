{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for RSpec.
        Maps unit and integration testing to the global test group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object for Ruby testing.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "rspec",
        "name": "RSpec",
        "icon": "🧪",
        "group": groups.test,
        "command": "$(" ~ s.ruby_tools.bundler.label ~ ") exec $(" ~ s.ruby_tools.rspec.label ~ ")",
        "description": "Behavior Driven Development testing framework for Ruby.",
        "modes": {
            "test": {
                "args": "--format documentation",
                "start_msg": "🧪 Running RSpec unit and integration tests...",
                "end_msg": "✅ Ruby tests complete!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}
