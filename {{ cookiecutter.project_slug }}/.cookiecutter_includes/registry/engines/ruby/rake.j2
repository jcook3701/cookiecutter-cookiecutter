{% macro get_config(groups, settings, result) %}
    {%- set s = settings -%}
    {%- set config = {
        "id": "rake",
        "name": "Rake",
        "icon": "⚙️",
        "group": groups.pkg,
        "command": "$(" ~ s.ruby_tools.bundler.label ~ ") exec $(" ~ s.ruby_tools.rake.label ~ ")",
        "description": "Ruby build program (task runner).",
        "modes": {
            "list": {
                "args": "-T",
                "start_msg": "⚙️ Listing Rake tasks...",
                "end_msg": "✅ Listing complete!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}
