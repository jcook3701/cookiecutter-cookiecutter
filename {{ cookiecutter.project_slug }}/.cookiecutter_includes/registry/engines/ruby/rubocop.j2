{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for RuboCop.
        Maps static analysis and auto-formatting to the global lint and format groups.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object for Ruby linting and formatting.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "rubocop",
        "name": "RuboCop",
        "icon": "🔍",
        "group": groups.lint,
        "command": "$(" ~ s.ruby_tools.bundler.label ~ ") exec $(" ~ s.ruby_tools.rubocop.label ~ ")",
        "description": "A Ruby static code analyzer (linter) and formatter.",
        "modes": {
            "lint": {
                "args": "-A",
                "start_msg": "🔍 Running RuboCop for Ruby static analysis...",
                "end_msg": "✅ RuboCop check complete!"
            },
            "format": {
                "args": "-x",
                "start_msg": "✨ Formatting Ruby code with RuboCop...",
                "end_msg": "🎨 Ruby formatting complete!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}
