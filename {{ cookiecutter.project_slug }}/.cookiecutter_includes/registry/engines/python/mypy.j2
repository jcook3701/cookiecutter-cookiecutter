{% set python_cmd %}
MYPY := $(PYTHON) -m mypy
{% endset %}


{% set shell_cmd %}
typecheck:
	$(AT)echo "🧠 Checking types (MyPy)..."
	$(AT)$(MAKE) list-folders
	$(AT)$(call run_ci_safe, $(MYPY) $(SRC_DIR) $(TESTS_DIR))
	$(AT)echo "✅ Python typecheck complete!"
{% endset %}
