{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for the Python build module.
        Maps source distribution and wheel creation to the global packaging group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object including the group metadata.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "build",
        "name": "Build System",
        "icon": "📦",
        "group": groups.pkg,
        "command": "$(" ~ s.python_infra.python.label ~ ") -m build",
        "description": "Standard PEP 517 compliant Python package builder.",
        "modes": {
            "package": {
                "args": "",
                "start_msg": "📦 Packing $(" ~ s.project.name.label ~ ")...",
                "end_msg": "✅ $(" ~ s.project.name.label ~ ") packaging complete!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}

{# We add a custom action here because you want a specific echo message #}
{% macro actions(cfg=config) %}
# --- {{ cfg.name }} ---
{{ cfg.id }}: ## {{ cfg.icon }} Package the project
	$(AT)echo "{{ cfg.icon }} Packing $(PROJECT_NAME)..."
	$(AT)$(BUILD)
	$(AT)echo "✅ $(PROJECT_NAME) packaging complete!"
{% endmacro %}
