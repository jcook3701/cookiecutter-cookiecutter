{% set config = {
    "id": "codespell",
    "name": "Codespell",
    "icon": "🎓",
    "group": "spelling",
    "command": "$(ACTIVATE) && codespell",
    "start_msg": "Checking Spelling (codespell)...",
    "end_msg": "Finished spellcheck!",
    "ci_safe": true,
    "modes": {
        "run": ""
    }
} %}

{# #TODO: Deprecated beyond this point!!!! #}
{% set python_cmd %}
CODESPELL := $(ACTIVATE) && codespell
{% endset %}


{% set shell_cmd %}
spellcheck:
	$(AT)echo "🎓 Checking Spelling (codespell)..."
	$(AT)$(call run_ci_safe, $(CODESPELL))
	$(AT)echo "✅ Finished spellcheck!"
{% endset %}
