{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for the Cookiecutter Project Upgrader.
        Maps template synchronization and project maintenance to the upgrader group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object including the group metadata.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "cookiecutter_project_upgrader",
        "name": "Project Upgrader",
        "icon": "🍪",
        "group": groups.upgrader,
        "command": "$(" ~ s.python_infra.activate.label ~ ") && cookiecutter_project_upgrader",
        "description": "Syncs the project with the latest version of its parent template.",
        "modes": {
            "run": {
                "args": "--context-file $(" ~ s.dirs.docs.label ~ ")/cookiecutter_input.json " ~
                        "--upgrade-branch main " ~
                        "-e 'cookiecutter.json' " ~
                        "-e '$(" ~ s.cookie.template_dir.label ~ ")'",
                "start_msg": "🍪 Upgrading project from initial cookiecutter template...",
                "end_msg": "✅ Finished project upgrade!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}


{# #TODO: Deprecated beyond this point!!!! #}
{% set python_cmd %}
PROJECT_UPGRADE := $(ACTIVATE) && cookiecutter_project_upgrader
{% endset %}


{% set shell_cmd %}
project-upgrade:
	$(AT)echo "🍪 Upgrading project from initial cookiecutter template..."
	$(AT)$(PROJECT_UPGRADE) --context-file ./docs/cookiecutter_input.json \
		--upgrade-branch main \
		-e "cookiecutter.json" \
		-e "$(COOKIE_DIR)"
	$(AT)echo "✅ Finished project upgrade!"
{% endset %}
