{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for the djLint tool.
        Maps Jinja2 and HTML linting/formatting to the global linting group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object including the group metadata.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "djlint",
        "name": "djLint",
        "icon": "✨",
        "group": groups.lint,
        "command": "$(" ~ s.python_infra.activate.label ~ ") && djlint",
        "description": "Linting and reformatting for Jinja2 and HTML templates.",
        "ci_safe": true,
        "modes": {
            "lint-check": {
                "args": "$(" ~ s.dirs.root.label ~ ") --lint --profile=jinja",
                "start_msg": "🔍 Running djLint style check on Jinja2 templates...",
                "end_msg": "✅ Finished linting check of jinja2 macro files with djlint!"
            },
            "lint-fix": {
                "args": "$(" ~ s.dirs.root.label ~ ") --reformat",
                "start_msg": "✨ Reformatting Jinja2 templates with djLint...",
                "end_msg": "🎨 djLint reformat complete!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}


