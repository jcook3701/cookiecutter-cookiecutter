{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for the Bump-My-Version tool.
        Maps version advancement (major, minor, patch) to the global versioning group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object including the group metadata.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "bumpversion",
        "name": "Bump-My-Version",
        "icon": "🔖",
        "group": groups.version,
        "command": "$(" ~ s.python_infra.activate.label ~ ") && bump-my-version bump --verbose",
        "description": "Version bumping tool with Git tagging support.",
        "modes": {
            "patch": {
                "args": "patch",
                "start_msg": "🔖 Updating $(" ~ s.project.name.label ~ ") patch version from $(" ~ s.project.version.label ~ ")...",
                "end_msg": "✅ Patch version update complete!"
            },
            "minor": {
                "args": "minor",
                "start_msg": "🔖 Updating $(" ~ s.project.name.label ~ ") minor version from $(" ~ s.project.version.label ~ ")...",
                "end_msg": "✅ Minor version update complete!"
            },
            "major": {
                "args": "major",
                "start_msg": "🔖 Updating $(" ~ s.project.name.label ~ ") major version from $(" ~ s.project.version.label ~ ")...",
                "end_msg": "✅ Major version update complete!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}


{% macro helpers() %}
# Patch types:
MAJOR := major
MINOR := minor
PATCH := patch
{% endmacro %}


