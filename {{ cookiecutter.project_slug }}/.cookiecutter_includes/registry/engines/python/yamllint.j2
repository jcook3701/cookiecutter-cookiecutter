{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for the Yamllint tool.
        Maps YAML file validation and linting to the global linting group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object including the group metadata.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "yamllint",
        "name": "Yamllint",
        "icon": "📄",
        "group": groups.lint,
        "command": "$(" ~ s.python_infra.python.label ~ ") -m yamllint",
        "description": "A linter for YAML files that checks for syntax validity and style.",
        "modes": {
            "check": {
                "args": "$(" ~ s.dirs.root.label ~ ") $(" ~ s.cookie.render_dir.label ~ ")",
                "start_msg": "🔍 Running Yamllint check on YAML files...",
                "end_msg": "✅ Finished linting check of yaml files with yamllint!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}


