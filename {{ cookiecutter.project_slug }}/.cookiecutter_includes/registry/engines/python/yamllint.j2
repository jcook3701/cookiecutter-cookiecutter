{% set python_cmd %}
YAMLLINT := $(PYTHON) -m yamllint
{% endset %}


{% set shell_cmd %}
yaml-lint-check:
	$(AT)echo "🔍 Running yamllint..."
	$(AT)$(YAMLLINT) $(PROJECT_ROOT)
	$(AT)$(YAMLLINT) $(RENDERED_COOKIE_DIR)
	$(AT)echo "✅ Finished linting check of yaml files with yamllint!"
{% endset %}
