{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for the Python Virtual Environment tool.
        Maps environment creation and isolation to the global setup group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object including the group metadata.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "venv",
        "name": "Virtual Environment",
        "icon": "🐍",
        "group": groups.setup,
        "command": "$(PYTHON_CMD) -m venv",
        "description": "Creation of virtual environments for Python package isolation.",
        "modes": {
            "create": {
                "args": "$(" ~ s.python_infra.venv_dir.label | default('VENV_DIR') ~ ")",
                "start_msg": "🐍 Creating Python virtual environment...",
                "end_msg": "✅ Virtual environment created successfully!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}


{# We define the ACTIVATE and PYTHON strings here as they are helpers, not just tools #}
{% macro helpers() %}
CREATE_VENV := $(PYTHON_CMD) -m venv $(VENV_DIR)
ACTIVATE := source $(VENV_DIR)/bin/activate
PYTHON := $(ACTIVATE) && $(PYTHON_CMD)
{% endmacro %}


