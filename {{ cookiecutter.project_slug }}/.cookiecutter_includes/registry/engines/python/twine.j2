{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for the Twine publishing tool.
        Maps Python package uploads to the global release group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object including the group metadata.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "twine",
        "name": "Twine",
        "icon": "🚀",
        "group": groups.release,
        "command": "$(PYTHON) -m twine",
        "description": "Utility for publishing Python packages to PyPI.",
        "modes": {
            "test": {
                "args": "upload --repository testpypi --verbose dist/*",
                "start_msg": "🚀 Publishing $(" ~ s.project.PROJECT_NAME.val ~ ") to TestPyPI...",
                "end_msg": "✅ $(" ~ s.project.PROJECT_NAME.val ~ ") test upload complete!"
            },
            "publish": {
                "args": "upload dist/*",
                "start_msg": "🚀 Publishing $(" ~ s.project.PROJECT_NAME.val ~ ") to PyPI...",
                "end_msg": "✅ $(" ~ s.project.PROJECT_NAME.val ~ ") production upload complete!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}


