{%- do v.ns.settings.update({
    "typescript_infra": {
        "_title": "JS/TS Environment Setup",
        "_icon": "📦",
        "NODE": {"val": "node"},
        "NPM":  {"val": "npm"},
        "NPX":  {"val": "npx"}
    }
}) -%}


{% set typescript_dev_stack = [
    {
        "id": "npm-install",
        "name": "NPM Install",
        "icon": "📦",
        "group": "deps",
        "command": "npm install",
        "args": "",
        "description": "Install project dependencies from package.json."
    },
    {
        "id": "tsc-build",
        "name": "TSC Build",
        "icon": "🏗️",
        "group": "build",
        "command": "npx tsc",
        "args": "--project tsconfig.json",
        "description": "Compile TypeScript to JavaScript."
    },
    {
        "id": "eslint",
        "name": "ESLint",
        "icon": "🛡️",
        "group": "lint",
        "command": "npx eslint",
        "args": "src/**/*.ts --fix",
        "description": "Statically analyze code to find problems."
    },
    {
        "id": "prettier",
        "name": "Prettier",
        "icon": "✨",
        "group": "format",
        "command": "npx prettier",
        "args": "--write src/**/*.ts",
        "description": "Opinionated code formatter."
    },
    {
        "id": "vitest",
        "name": "Vitest",
        "icon": "🧪",
        "group": "test",
        "command": "npx vitest",
        "args": "run",
        "description": "A Vite-native unit test framework."
    },
    {
        "id": "typedoc",
        "name": "TypeDoc",
        "icon": "📚",
        "group": "docs",
        "command": "npx typedoc",
        "args": "--out docs/api src/index.ts",
        "description": "Documentation generator for TypeScript."
    },
    {
        "id": "npm-publish",
        "name": "NPM Publish",
        "icon": "🚢",
        "group": "publish",
        "command": "npm publish",
        "args": "--access public",
        "description": "Publish the package to the npm registry."
    }
] %}

{#
# Only run npm install if package.json has changed
node_modules: package.json
	$(AT)npm install
	$(AT)touch node_modules

tsc-build: node_modules ## 🏗️ Compile TS
	$(AT)npx tsc $(ARGS)

#}
