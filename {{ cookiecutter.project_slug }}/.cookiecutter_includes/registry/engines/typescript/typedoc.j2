{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for TypeDoc.
        Maps TypeScript API documentation generation to the global docs group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object including the group metadata.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "typedoc",
        "name": "TypeDoc",
        "icon": "📚",
        "group": groups.docs,
        "command": "$(NPX) typedoc",
        "description": "Documentation generator for TypeScript projects.",
        "modes": {
            "build": {
                "args": "--out $(" ~ s.dirs.DOCS_DIR.val ~ ")/api",
                "start_msg": "📚 Generating TypeScript API documentation...",
                "end_msg": "✅ TypeScript documentation complete!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}
