{% macro get_config(groups, settings, result) %}
    {#
        Provides the configuration dictionary for the ESLint tool.
        Maps TypeScript and JavaScript linting to the global linting group.

        Args:
            groups (dict): The hydrated ns.pkg_groups dictionary.
            settings (dict): The hydrated settings dictionary.
            result (dict): A dictionary to be updated with the config.

        Returns:
            dict: The tool configuration object including the group metadata.
    #}
    {%- set s = settings -%}
    {%- set config = {
        "id": "eslint",
        "name": "ESLint",
        "icon": "🛡️",
        "group": groups.lint,
        "command": "npx eslint",
        "description": "Find and fix problems in your JavaScript and TypeScript code.",
        "modes": {
            "check": {
                "args": "--ext .ts,.tsx $(" ~ s.dirs.root.label ~ ")",
                "start_msg": "🔍 Running ESLint check on TypeScript files...",
                "end_msg": "✅ Finished linting check with ESLint!"
            },
            "fix": {
                "args": "--ext .ts,.tsx $(" ~ s.dirs.root.label ~ ") --fix",
                "start_msg": "🛠️  Applying ESLint automated fixes...",
                "end_msg": "✨ ESLint fixes applied successfully!"
            }
        }
    } -%}
    {%- do result.update(config) -%}
{% endmacro %}
