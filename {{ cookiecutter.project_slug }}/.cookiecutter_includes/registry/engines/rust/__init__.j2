{%- import '.cookiecutter_includes/registry/utils.j2' as utils with context -%}
{%- import '.cookiecutter_includes/registry/engines/rust/built-in.j2' as _built_in with context -%}
{%- import '.cookiecutter_includes/registry/engines/rust/git-cliff.j2' as _git_cliff with context -%}

{% macro get_active_tools(ns) %}
    {%- set cargo = {} -%}
    {%- set git_cliff = {} -%}

    {%- do _built_in.get_config(ns.pkg_groups, ns.settings, cargo) -%}
    {%- do _git_cliff.get_config(ns.pkg_groups, ns.settings, git_cliff) -%}

    {%- set tools_to_check = [
        cargo,
        git_cliff
    ] -%}

    {%- for tool_cfg in tools_to_check -%}
        {%- if tool_cfg is mapping -%}
            {%- set feature_id = tool_cfg.id | upper | replace("-", "_") -%}

            {%- set is_core = feature_id in ['GIT_CLIFF'] -%}
            {%- set is_enabled = ns.features.engines.rust.get(feature_id) | default(false) -%}

            {%- if is_core or is_enabled -%}
                {{- utils.register_tool(ns, tool_cfg) -}}
            {%- endif -%}
        {%- endif -%}
    {%- endfor -%}
{% endmacro %}
